<mxfile host="app.diagrams.net"><diagram name="AS-IS fulfillment and diagnostic visibility"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AS-IS fulfillment and diagnostic visibility" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#20343C;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1020" height="35" as="geometry"/></mxCell><mxCell id="subtitle" value="Modeled process · operational controls require stakeholder confirmation" style="text;align=left;fontSize=16;fontColor=#617680;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1020" height="28" as="geometry"/></mxCell><mxCell id="placed" value="&lt;b&gt;Customer places order&lt;/b&gt;&lt;br&gt;&lt;small&gt;Customer&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#20343C;fontColor=#FFFFFF;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="95" width="220" height="70" as="geometry"/></mxCell><mxCell id="prepare" value="&lt;b&gt;Seller prepares order&lt;/b&gt;&lt;br&gt;&lt;small&gt;Seller&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="340" y="95" width="220" height="70" as="geometry"/></mxCell><mxCell id="handoff" value="&lt;b&gt;Carrier handoff recorded&lt;/b&gt;&lt;br&gt;&lt;small&gt;Seller / carrier&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="640" y="95" width="220" height="70" as="geometry"/></mxCell><mxCell id="delivery" value="&lt;b&gt;Customer receives order&lt;/b&gt;&lt;br&gt;&lt;small&gt;Carrier&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;st