<mxfile host="app.diagrams.net"><diagram name="Olist data lineage"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Olist data lineage" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#20343C;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1020" height="35" as="geometry"/></mxCell><mxCell id="subtitle" value="Nine source tables · governed grains before joins" style="text;align=left;fontSize=16;fontColor=#617680;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1020" height="28" as="geometry"/></mxCell><mxCell id="orders" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;small&gt;One row per order&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#20343C;fontColor=#FFFFFF;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="210" width="220" height="70" as="geometry"/></mxCell><mxCell id="customers" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;small&gt;customer_id → unique_id&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="items" value="&lt;b&gt;Order items&lt;/b&gt;&lt;br&gt;&lt;small&gt;order_id + item sequence&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="340" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="reviews" value="&lt;b&gt;Reviews&lt;/b&gt;&lt;br&gt;&lt;small&gt;Aggregate score per order&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;wh