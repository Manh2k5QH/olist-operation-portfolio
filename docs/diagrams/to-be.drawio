<mxfile host="app.diagrams.net"><diagram name="TO-BE delivery exception pilot"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="TO-BE delivery exception pilot" style="text;align=left;fontSize=24;fontStyle=1;fontColor=#20343C;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1020" height="35" as="geometry"/></mxCell><mxCell id="subtitle" value="Proposed operating workflow · live events and owners required" style="text;align=left;fontSize=16;fontColor=#617680;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1020" height="28" as="geometry"/></mxCell><mxCell id="feed" value="&lt;b&gt;Receive order status feed&lt;/b&gt;&lt;br&gt;&lt;small&gt;BI / platform · freshness check&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#20343C;fontColor=#FFFFFF;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="95" width="220" height="70" as="geometry"/></mxCell><mxCell id="eligible" value="&lt;b&gt;Evaluate open orders&lt;/b&gt;&lt;br&gt;&lt;small&gt;Exclude delivered / canceled&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="340" y="95" width="220" height="70" as="geometry"/></mxCell><mxCell id="flag" value="&lt;b&gt;Threshold crossed?&lt;/b&gt;&lt;br&gt;&lt;small&gt;Configured days to ETA&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFC928;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="640" y="85" width="180" height="90" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b&gt;Create or update one case&lt;/b&gt;&lt;br&gt;&lt;small&gt;Operations · dedup by order&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="640" y="245" width="220" height="70" as="geometry"/></mxCell><mxCell id="assign" value="&lt;b&gt;Assign owner and due time&lt;/b&gt;&lt;br&gt;&lt;small&gt;Operations lead&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="340" y="245" width="220" height="70" as="geometry"/></mxCell><mxCell id="action" value="&lt;b&gt;Investigate and intervene&lt;/b&gt;&lt;br&gt;&lt;small&gt;Seller / carrier liaison&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="245" width="220" height="70" as="geometry"/></mxCell><mxCell id="monitor" value="&lt;b&gt;Monitor until resolution&lt;/b&gt;&lt;br&gt;&lt;small&gt;CX · escalation if overdue&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="425" width="220" height="70" as="geometry"/></mxCell><mxCell id="close" value="&lt;b&gt;Close with outcome + cost&lt;/b&gt;&lt;br&gt;&lt;small&gt;Operations · retain audit&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFFFFF;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="340" y="425" width="220" height="70" as="geometry"/></mxCell><mxCell id="measure" value="&lt;b&gt;Evaluate pilot vs comparator&lt;/b&gt;&lt;br&gt;&lt;small&gt;BA / BI · 30/60/90-day review&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#FFC928;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="640" y="425" width="220" height="70" as="geometry"/></mxCell><mxCell id="decide" value="&lt;b&gt;Continue, revise or stop&lt;/b&gt;&lt;br&gt;&lt;small&gt;Logistics sponsor&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#20343C;fontColor=#FFFFFF;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="640" y="565" width="220" height="70" as="geometry"/></mxCell><mxCell id="wait" value="&lt;b&gt;Continue monitoring&lt;/b&gt;&lt;br&gt;&lt;small&gt;No active case&lt;/small&gt;" style="rounded=1;arcSize=12;strokeWidth=1;strokeColor=#BBC9CE;fillColor=#EAF0F2;fontColor=#20343C;fontSize=16;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="900" y="95" width="180" height="70" as="geometry"/></mxCell><mxCell id="edge0" value="fresh data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="feed" target="eligible"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge1" value="valid ETA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="eligible" target="flag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="flag" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="flag" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="queue" target="assign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="owner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="assign" target="action"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="action log" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="action" target="monitor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="monitor" target="close"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="close" target="measure"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#788D96;strokeWidth=1.5;endArrow=block;html=1;fontSize=12;labelBackgroundColor=#F5F7F8" edge="1" parent="1" source="measure" target="decide"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Primary outcome is late rate on eligible delivered orders. Guardrails cover cancellations, unresolved orders, ETA length, queue workload and intervention cost. Same ETA calendar day is on time." style="text;align=left;fontSize=14;fontColor=#617680;html=1;whiteSpace=wrap;fontFamily=Arial" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1020" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
